GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase-konfig — finn disse i Firebase Console → Project settings → Web app
# Disse er OFFENTLIGE og kan ligge i kildekoden. Firestore-regler beskytter dataene.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="prosjektnavn.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="prosjektnavn"
VITE_FIREBASE_STORAGE_BUCKET="prosjektnavn.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abc123"

# openrouteservice (https://github.com/GIScience/openrouteservice) — gangruter.
# Hentes via /api/route på serveren, så nøkkelen er IKKE VITE_-prefikset og
# havner aldri i nettleseren. Gratis nøkkel: https://openrouteservice.org/dev
# Uten nøkkel bruker appen det innebygde stinettet (src/data/road_network.json).
ORS_API_KEY=""
# Valgfritt: egen ORS-instans i stedet for det offentlige API-et (da trengs ingen nøkkel)
# ORS_BASE_URL="http://localhost:8080/ors"
